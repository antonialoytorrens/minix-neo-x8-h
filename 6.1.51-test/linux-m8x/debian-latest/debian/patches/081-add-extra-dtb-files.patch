Add the extra board dtb files (previously only their Makefile entries were
patched in, without the .dts/.dtsi sources themselves ever being added to the
tree -- this made the patch fail to apply regardless of kernel version). Now
self-contained: includes meson8-mxiii.dtsi/.dts, meson8-minix-neo-x8h.dts and
meson8m2-m8s-dvfs.dts alongside the Makefile change.

diff --git a/arch/arm/boot/dts/Makefile b/arch/arm/boot/dts/Makefile
index 8fadfd01bf..bab5d21965 100644
--- a/arch/arm/boot/dts/Makefile
+++ b/arch/arm/boot/dts/Makefile
@@ -399,13 +399,16 @@ dtb-$(CONFIG_MACH_MESON6) += \
 	meson6-atv1200.dtb
 dtb-$(CONFIG_MACH_MESON8) += \
 	meson8-minix-neo-x8.dtb \
+	meson8-minix-neo-x8h.dtb \
 	meson8-tronsmart-s82.dtb \
+	meson8-mxiii.dtb \
 	meson8b-ec100.dtb \
 	meson8b-mxq.dtb \
 	meson8b-odroidc1.dtb \
 	meson8m2-mxiii.dtb \
 	meson8m2-mxiii-plus.dtb \
 	meson8m2-m8s.dtb \
+	meson8m2-m8s-dvfs.dtb \
 	meson8m2-wetek-core.dtb
 dtb-$(CONFIG_ARCH_MMP) += \
 	pxa168-aspenite.dtb \
diff --git a/arch/arm/boot/dts/meson8-minix-neo-x8h.dts b/arch/arm/boot/dts/meson8-minix-neo-x8h.dts
new file mode 100644
index 0000000000..9e341664e2
--- /dev/null
+++ b/arch/arm/boot/dts/meson8-minix-neo-x8h.dts
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device tree for the MINIX NEO X8-H, a Tronsmart MXIII variant.
+ */
+
+/dts-v1/;
+
+#include "meson8-mxiii.dtsi"
+
+/ {
+	model = "MINIX NEO-X8-H";
+	compatible = "tronsmart,mxiii", "amlogic,meson8m2";
+
+	iio-hwmon {
+		compatible = "iio-hwmon";
+		io-channels = <&saradc 8>;
+	};
+
+	gpio-keys-polled {
+		compatible = "gpio-keys-polled";
+		poll-interval = <100>;
+
+		button-power {
+			label = "power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpio_ao GPIOAO_3 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&ethmac {
+	status = "okay";
+
+	pinctrl-0 = <&eth_pins>;
+	pinctrl-names = "default";
+
+	phy-handle = <&eth_phy0>;
+	phy-mode = "rmii";
+
+	mdio {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		eth_phy0: ethernet-phy@0 {
+			/* IC Plus IP101A/G (0x02430c54) */
+			reg = <0>;
+			icplus,select-interrupt;
+			interrupt-parent = <&gpio_intc>;
+			/* GPIODV_29 = 94 and GPIOZ_4 are not working */
+			/* interrupts = <94 IRQ_TYPE_LEVEL_LOW>; */
+
+			reset-assert-us = <10000>;
+			reset-deassert-us = <10000>;
+			reset-gpios = <&gpio GPIOZ_14 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+/* SDIO wifi */
+&sdhc {
+	status = "okay";
+
+	pinctrl-0 = <&sdxc_a_pins>;
+	pinctrl-names = "default";
+
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	bus-width = <4>;
+	max-frequency = <25000000>;
+
+	disable-wp;
+	non-removable;
+	no-mmc;
+	no-sd;
+	cap-sd-highspeed;
+	keep-power-in-suspend;
+
+	mmc-pwrseq = <&sdio_pwrseq>;
+
+	vmmc-supply = <&vcc_3v3>;
+	vqmmc-supply = <&vcc_3v3>;
+
+	wifi@1 {
+		compatible = "brcm,bcm4329-fmac";
+		reg = <1>;
+
+		/*
+		 * Out-of-band host-wake. Requires the irq-meson-gpio
+		 * IRQCHIP_SKIP_SET_WAKE patch, otherwise brcmfmac's
+		 * enable_irq_wake() fails with -6.
+		 */
+		interrupt-parent = <&gpio_intc>;
+		interrupts = <GPIOX_21 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "host-wake";
+	};
+};
+
+/* SD card */
+&sdio {
+	status = "okay";
+
+	pinctrl-0 = <&sd_b_pins>;
+	pinctrl-names = "default";
+
+	slot@0 {
+		compatible = "mmc-slot";
+		reg = <1>;
+
+		bus-width = <4>;
+		max-frequency = <50000000>;
+
+		no-mmc;
+		no-sdio;
+		cap-sd-highspeed;
+		disable-wp;
+
+		cd-gpios = <&gpio CARD_6 GPIO_ACTIVE_LOW>;
+
+		vmmc-supply = <&vcc_3v3>;
+	};
+};
diff --git a/arch/arm/boot/dts/meson8-mxiii.dts b/arch/arm/boot/dts/meson8-mxiii.dts
