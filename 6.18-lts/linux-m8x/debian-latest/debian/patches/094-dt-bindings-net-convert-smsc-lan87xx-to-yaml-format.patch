From 996e2a00f54e6a9df44c2e766ce72893958f0f38 Mon Sep 17 00:00:00 2001
From: Martin Blumenstingl <martin.blumenstingl@googlemail.com>
Date: Mon, 22 Dec 2025 01:20:03 +0100
Subject: [PATCH 94/98] dt-bindings: net: Convert smsc-lan87xx to yaml format

This allows for validation of .dts files.

Signed-off-by: Martin Blumenstingl <martin.blumenstingl@googlemail.com>
---
 .../devicetree/bindings/net/smsc,lan87xx.yaml | 62 +++++++++++++++++++
 .../devicetree/bindings/net/smsc-lan87xx.txt  | 27 --------
 2 files changed, 62 insertions(+), 27 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/net/smsc,lan87xx.yaml
 delete mode 100644 Documentation/devicetree/bindings/net/smsc-lan87xx.txt

diff --git a/Documentation/devicetree/bindings/net/smsc,lan87xx.yaml b/Documentation/devicetree/bindings/net/smsc,lan87xx.yaml
new file mode 100644
index 00000000000000..5c87a15f1eec7c
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/smsc,lan87xx.yaml
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: GPL-2.0+
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/smsc,lan87xx.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SMSC / Microchip LAN87xx PHY
+
+maintainers:
+  - Andrew Lunn <andrew@lunn.ch>
+  - Florian Fainelli <f.fainelli@gmail.com>
+
+description:
+  Bindings for SMSC / Microchip LAN87xx PHYs
+
+allOf:
+  - $ref: ethernet-phy.yaml#
+
+properties:
+  compatible:
+    enum:
+      - ethernet-phy-id0007.c0a0 # LAN83C185
+      - ethernet-phy-id0007.c0b0 # LAN8187
+      - ethernet-phy-id0007.c0c0 # LAN8700
+      - ethernet-phy-id0007.c0c3 # LAN8700
+      - ethernet-phy-id0007.c0d0 # LAN911x Internal PHY
+      - ethernet-phy-id0007.c0f0 # LAN8710/LAN8720
+      - ethernet-phy-id0007.c0f1 # LAN8710/LAN8720
+      - ethernet-phy-id0007.c110 # LAN8740
+      - ethernet-phy-id0007.c130 # LAN8742
+      - ethernet-phy-id0007.c131 # LAN8742
+
+  clocks:
+    maxItems: 1
+    description: |
+      The clock used as phy reference clock and is connected to phy
+      pin XTAL1/CLKIN.
+
+  smsc,disable-energy-detect:
+    type: boolean
+    description: |
+      If set, do not enable energy detect mode for the SMSC PHY.
+      default: enable energy detect mode
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    mdio {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        ethernet-phy@1 {
+            reg = <1>;
+            clock = <&phy_clk_in>;
+        };
+
+        ethernet-phy@2 {
+            reg = <2>;
+            smsc,disable-energy-detect;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/net/smsc-lan87xx.txt b/Documentation/devicetree/bindings/net/smsc-lan87xx.txt
deleted file mode 100644
index a8d0dc9a8c0ecb..00000000000000
--- a/Documentation/devicetree/bindings/net/smsc-lan87xx.txt
+++ /dev/null
@@ -1,27 +0,0 @@
-SMSC LAN87xx Ethernet PHY
-
-Some boards require special tuning values. Configure them
-through an Ethernet OF device node.
-
-Optional properties:
-
-- clocks:
-  The clock used as phy reference clock and is connected to phy
-  pin XTAL1/CLKIN.
-
-- smsc,disable-energy-detect:
-  If set, do not enable energy detect mode for the SMSC phy.
-  default: enable energy detect mode
-
-Examples:
-smsc phy with disabled energy detect mode on an am335x based board.
-&davinci_mdio {
-	pinctrl-names = "default", "sleep";
-	pinctrl-0 = <&davinci_mdio_default>;
-	pinctrl-1 = <&davinci_mdio_sleep>;
-
-	ethernetphy0: ethernet-phy@0 {
-		reg = <0>;
-		smsc,disable-energy-detect;
-	};
-};

