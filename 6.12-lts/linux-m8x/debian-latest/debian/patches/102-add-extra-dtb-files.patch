+			interrupts = <0x00 0x22 0x01>;
+			#address-cells = <0x01>;
+			#size-cells = <0x00>;
+			clocks = <0x03 0x35 0x03 0x70>;
+			clock-names = "core", "nand";
+			status = "disabled";
+		};
+
+		vpu@100000 {
+			compatible = "amlogic,meson8-vpu";
+			reg = <0x100000 0x10000>;
+			reg-names = "vpu";
+			interrupts = <0x00 0x03 0x01>;
+			amlogic,canvas = <0x37>;
+			assigned-clocks = <0x03 0x8a 0x03 0x95>;
+			assigned-clock-parents = <0x03 0x89 0x03 0x89>;
+			clocks = <0x03 0x46 0x03 0x3e 0x03 0x4d 0x03 0x84 0x03 0xa7 0x03 0xa3 0x03 0xa5 0x03 0xa1 0x03 0xa9 0x03 0xab>;
+			clock-names = "vpu_intr", "hdmi_intr_sync", "venci_int", "tmds", "hdmi_tx_pixel", "cts_encp", "cts_enci", "cts_enct", "cts_encl", "cts_vdac0";
+			resets = <0x03 0x0f 0x03 0x0e 0x03 0x0d 0x03 0x0c>;
+			reset-names = "vid_pll_pre", "vid_pll_post", "vid_pll_soft_pre", "vid_pll_soft_post";
+			phys = <0x38>;
+			phy-names = "cvbs-dac";
+			power-domains = <0x21 0x00>;
+			#address-cells = <0x01>;
+			#size-cells = <0x00>;
+
+			port@0 {
+				reg = <0x00>;
+
+				endpoint {
+					remote-endpoint = <0x39>;
+					phandle = <0x3b>;
+				};
+			};
+
+			port@1 {
+				reg = <0x01>;
+
+				endpoint {
+					remote-endpoint = <0x3a>;
+					phandle = <0x35>;
+				};
+			};
+		};
+	};
+
+	aliases {
+		ethernet0 = "/soc/ethernet@c9410000";
+		i2c0 = "/soc/aobus@c8100000/i2c@500";
+		serial0 = "/soc/aobus@c8100000/serial@4c0";
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory {
+		reg = <0x40000000 0x40000000>;
+		device_type = "memory";
+	};
+
+	adc-keys {
+		compatible = "adc-keys";
+		io-channels = <0x02 0x00>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <0x1a17b0>;
+
+		button-function {
+			label = "Function";
+			linux,code = <0x1d0>;
+			press-threshold-microvolt = <0x2710>;
+		};
+	};
+
+	cvbs-connector {
+		compatible = "composite-video-connector";
+
+		port {
+
+			endpoint {
+				remote-endpoint = <0x3b>;
+				phandle = <0x39>;
+			};
+		};
+	};
+
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+
+			endpoint {
+				remote-endpoint = <0x3c>;
+				phandle = <0x36>;
+			};
+		};
+	};
+
+	sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		pinctrl-0 = <0x3d>;
+		pinctrl-names = "default";
+		reset-gpios = <0x12 0x0b 0x01 0x3e 0x06 0x01>;
+		clocks = <0x3f>;
+		clock-names = "ext_clock";
+		phandle = <0x15>;
+	};
+
+	sound {
+		compatible = "amlogic,gx-sound-card";
+		model = "TRONSMART-MXIII";
+		assigned-clocks = <0x03 0x5d 0x03 0x5e>;
+		assigned-clock-rates = <0x10266000 0x11940000>;
+
+		dai-link-0 {
+			sound-dai = <0x40 0x00 0x00>;
+		};
+
+		dai-link-1 {
+			sound-dai = <0x40 0x00 0x01>;
+		};
+
+		dai-link-2 {
+			sound-dai = <0x40 0x00 0x02>;
+			dai-format = "i2s";
+			mclk-fs = <0x100>;
+
+			codec-0 {
+				sound-dai = <0x40 0x01 0x00>;
+			};
+		};
+
+		dai-link-3 {
+			sound-dai = <0x40 0x01 0x02>;
+
+			codec-0 {
+				sound-dai = <0x1d 0x00>;
+			};
+		};
+
+		dai-link-4 {
+			sound-dai = <0x40 0x00 0x03>;
+
+			codec-0 {
+				sound-dai = <0x41>;
+			};
+		};
+	};
+
+	spdif-audio-codec {
+		compatible = "linux,spdif-dit";
+		#sound-dai-cells = <0x00>;
+		sound-name-prefix = "DIT";
+		phandle = <0x41>;
+	};
+
+	regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "USB_VBUS";
+		regulator-min-microvolt = <0x4c4b40>;
+		regulator-max-microvolt = <0x4c4b40>;
+		gpio = <0x12 0x50 0x00>;
+		enable-active-high;
+		phandle = <0x1f>;
+	};
+
+	regulator-vcc3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "VCC3V3";
+		regulator-min-microvolt = <0x325aa0>;
+		regulator-max-microvolt = <0x325aa0>;
+		phandle = <0x13>;
+	};
+
+	xtal-32k-out-clk {
+		compatible = "fixed-clock";
+		#clock-cells = <0x00>;
+		clock-frequency = <0x8000>;
+		clock-output-names = "xtal_32k_out";
+		phandle = <0x3f>;
+	};
+
+	gpio-keys-polled {
+		compatible = "gpio-keys-polled";
+		poll-interval = <0x64>;
+
+		button-power {
+			label = "power";
+			linux,code = <0x74>;
+			gpios = <0x3e 0x03 0x01>;
+		};
+	};
+};

