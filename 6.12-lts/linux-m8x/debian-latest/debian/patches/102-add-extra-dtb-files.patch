+++ b/arch/arm/boot/dts/amlogic/Makefile
@@ -3,11 +3,14 @@
 	meson6-atv1200.dtb
 dtb-$(CONFIG_MACH_MESON8) += \
 	meson8-minix-neo-x8.dtb \
+	meson8-minix-neo-x8h.dtb \
 	meson8-tronsmart-s82.dtb \
+	meson8-mxiii.dtb \
 	meson8b-ec100.dtb \
 	meson8b-mxq.dtb \
 	meson8b-odroidc1.dtb \
 	meson8m2-m8s.dtb \
+	meson8m2-m8s-dvfs.dtb \
 	meson8m2-mxiii.dtb \
 	meson8m2-mxiii-plus.dtb \
